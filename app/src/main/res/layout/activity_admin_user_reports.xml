<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="#F5F7FA">


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:gravity="center_vertical"

        android:padding="16dp"

        android:background="#FFFFFF">


        <!-- BACK BUTTON -->
        <ImageButton
            android:id="@+id/btnBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:src="@android:drawable/ic_menu_revert"

            android:contentDescription="Back" />


        <!-- USER INFORMATION -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:orientation="vertical"

            android:layout_marginStart="8dp">


            <!-- SECTION TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="USER REPORTS"

                android:textColor="#1565C0"

                android:textSize="13sp"

                android:textStyle="bold" />


            <!-- USER NAME -->
            <TextView
                android:id="@+id/tvUserName"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:text="User"

                android:textColor="#111111"

                android:textSize="24sp"

                android:textStyle="bold" />


            <!-- USER EMAIL -->
            <TextView
                android:id="@+id/tvUserEmail"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="2dp"

                android:text="Email"

                android:textColor="#666666"

                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- CONTENT -->
    <!-- ========================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="16dp">


            <!-- ================================================= -->
            <!-- LOST REPORTS HEADER -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="14dp"

                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="18dp">


                    <!-- LOST REPORTS TITLE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Lost Reports"

                        android:textColor="#111111"

                        android:textSize="20sp"

                        android:textStyle="bold" />


                    <!-- LOST REPORT COUNT -->
                    <TextView
                        android:id="@+id/tvLostCount"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="0 Reports"

                        android:textColor="#1565C0"

                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- LOST EMPTY -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvLostEmpty"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"

                android:padding="20dp"

                android:text="No lost reports."

                android:textColor="#777777"

                android:textSize="14sp"

                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- LOST REPORTS LIST -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerLost"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:nestedScrollingEnabled="false" />


            <!-- ================================================= -->
            <!-- FOUND REPORTS HEADER -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:layout_marginBottom="14dp"

                app:cardCornerRadius="16dp"

                app:cardElevation="2dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="18dp">


                    <!-- FOUND REPORTS TITLE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Found Reports"

                        android:textColor="#111111"

                        android:textSize="20sp"

                        android:textStyle="bold" />


                    <!-- FOUND REPORT COUNT -->
                    <TextView
                        android:id="@+id/tvFoundCount"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="0 Reports"

                        android:textColor="#2E7D32"

                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- FOUND EMPTY -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvFoundEmpty"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"

                android:padding="20dp"

                android:text="No found reports."

                android:textColor="#777777"

                android:textSize="14sp"

                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- FOUND REPORTS LIST -->
            <!-- ================================================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFound"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </ScrollView>


    <!-- ========================================================= -->
    <!-- PROGRESS BAR -->
    <!-- ========================================================= -->

    <ProgressBar
        android:id="@+id/progressBar"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_gravity="center"

        android:visibility="gone" />


</LinearLayout>