<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#17151B">

    <!-- ====================================================== -->
    <!-- Toolbar - Fixed at Top -->
    <!-- ====================================================== -->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#CDB4F9"
        app:title="My Profile"
        app:titleTextColor="@android:color/white" />


    <!-- ====================================================== -->
    <!-- Scrollable Profile Content -->
    <!-- ====================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#17151B"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/profileContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- ================================================== -->
            <!-- Profile Picture -->
            <!-- ================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#29252F"
                app:cardCornerRadius="65dp"
                app:cardElevation="6dp"
                app:strokeColor="#514B5A"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#29252F"
                    android:contentDescription="Profile Picture"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_foreground" />

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================== -->
            <!-- Change Profile Picture -->
            <!-- ================================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:text="Change Photo"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="16dp" />


            <!-- ================================================== -->
            <!-- Profile Card -->
            <!-- ================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#211E26"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">


                    <!-- ========================================== -->
                    <!-- Full Name -->
                    <!-- ========================================== -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textColor="#BDB8C7"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Full Name">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFullName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:inputType="text"
                            android:textColor="@android:color/white"
                            android:textSize="17sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- ========================================== -->
                    <!-- Email -->
                    <!-- ========================================== -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Email"
                        android:textColor="#BDB8C7"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Email">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:inputType="textEmailAddress"
                            android:textColor="@android:color/white"
                            android:textSize="17sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- ========================================== -->
                    <!-- Phone Number -->
                    <!-- ========================================== -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Phone Number"
                        android:textColor="#BDB8C7"
                        android:textSize="14sp" />


                    <!-- Phone Row -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">


                        <!-- Country Code -->

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCountryCode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.95"
                            android:hint="Code"
                            app:endIconMode="dropdown_menu">

                            <AutoCompleteTextView
                                android:id="@+id/actvCountryCode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:completionThreshold="0"
                                android:focusable="false"
                                android:inputType="none"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:textColor="@android:color/white"
                                android:textSize="16sp" />

                        </com.google.android.material.textfield.TextInputLayout>


                        <!-- Space -->

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="1dp" />


                        <!-- Phone Number -->

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.05"
                            android:hint="Phone Number"
                            app:startIconDrawable="@android:drawable/ic_menu_call">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:maxLength="15"
                                android:textColor="@android:color/white"
                                android:textSize="17sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>


                    <!-- ========================================== -->
                    <!-- Address -->
                    <!-- ========================================== -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Address"
                        android:textColor="#BDB8C7"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Address">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAddress"
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:imeOptions="actionDone"
                            android:paddingStart="12dp"
                            android:paddingTop="16dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="16dp"
                            android:textColor="@android:color/white"
                            android:textSize="17sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- ========================================== -->
                    <!-- Save Profile -->
                    <!-- ========================================== -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="30dp"
                        android:text="Save Profile"
                        android:textAllCaps="false"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp" />


                    <!-- ========================================== -->
                    <!-- Progress -->
                    <!-- ========================================== -->

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="20dp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>