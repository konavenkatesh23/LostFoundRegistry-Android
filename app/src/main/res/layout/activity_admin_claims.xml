<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">


    <!-- ========================================================= -->
    <!-- TOOLBAR -->
    <!-- ========================================================= -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAdminClaims"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#F5F7FA"
        android:elevation="0dp"
        android:title="Pending Claims"
        android:titleTextColor="#1A1A1A"
        app:navigationIcon="@drawable/ic_arrow_back" />


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Claim Management"
            android:textColor="#1A1A1A"
            android:textSize="26sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvPendingClaimCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pending claims: 0"
            android:textColor="#666666"
            android:textSize="14sp" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- PROGRESS -->
    <!-- ========================================================= -->

    <ProgressBar
        android:id="@+id/progressAdminClaims"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />


    <!-- ========================================================= -->
    <!-- EMPTY -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/tvNoPendingClaims"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:text="No pending claims."
        android:textColor="#666666"
        android:textSize="16sp"
        android:visibility="gone" />


    <!-- ========================================================= -->
    <!-- RECYCLER VIEW -->
    <!-- ========================================================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAdminClaims"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp" />

</LinearLayout>